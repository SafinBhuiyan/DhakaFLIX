# -----------------------------------------------------------------------------
# DhakaFLIX Environment Configuration
# -----------------------------------------------------------------------------

# The Movie Database (TMDb) API Key
# Required for fetching posters, backdrops, ratings, and synopses during catalog sync and trailer lookups.
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Helper Relay URL (for streaming on mobile data via home BDIX server)
NEXT_PUBLIC_HELPER_RELAY_URL=https://your-tunnel.trycloudflare.com
